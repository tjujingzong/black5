# 默认：文本文件统一归一化为 LF 入库，按平台本地换行检出
* text=auto eol=lf

# 源码 / 标记：强制 LF
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.ts     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.htm    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf

# Shell 强制 LF
*.sh     text eol=lf

# Windows 脚本用 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制资源（不做换行转换）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.mp3    binary
*.wav    binary
*.mp4    binary
*.webm   binary
*.zip    binary
*.gz     binary
